# Shared workspace integrations. Keep real values in .env (never commit it).
NOTION_TOKEN=
NOTION_GOAL_DB_ID=
NOTION_DOCS_DB_ID=
NOTION_BUFFER_DB_ID=

# Meta App credentials are shared; Page tokens live in the JSON file below.
FB_APP_ID=
FB_APP_SECRET=
FB_PAGES_CONFIG=.secrets/facebook/pages.json

# Paths may be absolute or relative to the workspace root.
GDRIVE_CREDENTIALS_FILE=.secrets/google-drive/credentials.json
GDRIVE_TOKEN_FILE=.secrets/google-drive/token.json
